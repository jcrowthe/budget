{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "budget",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "budget.doxen.dev", "custom_domain": true }],
  "assets": {
    "directory": "../web/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "budget-db", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "budget-files" }],
  "durable_objects": {
    "bindings": [{ "name": "PLAID_ITEM_SYNC", "class_name": "PlaidItemSync" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlaidItemSync"] }],
  "triggers": { "crons": ["0 3,9,15,21 * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_HOSTNAME": "budget.doxen.dev",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ACCESS_ALLOWED_EMAIL": "",
    "ACCESS_SERVICE_TOKENS": "{}",
    "DEPLOY_SHA": "unknown"
  }
}
